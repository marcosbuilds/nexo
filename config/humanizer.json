{
  "version": "0.3.1",
  "purpose": "practical_fact_preserving_humanization_and_pre_send_gate",
  "mode": "block_then_regenerate",
  "filler_openers": [
    "great",
    "perfect",
    "understood",
    "got it",
    "sure",
    "absolutely",
    "of course"
  ],
  "corporate_phrases": [
    "strategic solution",
    "personalized solution",
    "add value",
    "it is worth noting",
    "at your disposal",
    "hope you are well"
  ],
  "chatbot_residue": [
    "hope this helps",
    "hope that helps",
    "let me know if you need anything else",
    "is there anything else i can help with"
  ],
  "punctuation": {
    "colon": {
      "max_per_250_chars": 1,
      "hard_fail_when_repeated": true,
      "exceptions": [
        "url",
        "time",
        "code",
        "explicit_label",
        "key_value_data"
      ]
    },
    "em_dash": {
      "max_per_250_chars": 1
    },
    "exclamation": {
      "max_consecutive": 1
    }
  },
  "rhythm": {
    "max_sentences_per_bubble": 3,
    "avoid_three_consecutive_short_sentences": true,
    "avoid_identical_opening_across_recent_messages": true,
    "avoid_all_bubbles_same_length": true
  },
  "commercial": {
    "one_dominant_goal_per_turn": true,
    "one_primary_cta_per_turn": true,
    "prefer_specific_words_over_marketing_adjectives": true,
    "do_not_add_persuasion_after_the_customer_already_committed": true
  },
  "action_on_failure": {
    "regenerate_with_issues": true,
    "preserve_facts_and_terms": true,
    "never_send_failed_draft": true
  },
  "practical_modes": ["pasted", "file", "embedded"],
  "fact_preservation": ["names", "numbers", "dates", "links", "code", "identifiers", "required_terms"],
  "rewrite_order": ["strategy", "structure", "rhythm", "wording", "final_fact_review"]
}
