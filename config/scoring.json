{
  "version": "0.3.1",
  "purpose": "evidence_based_customer_and_company_prioritization",
  "score_range": [
    0,
    100
  ],
  "entities": [
    "contact",
    "company",
    "opportunity"
  ],
  "dimensions": {
    "need_fit": 0.18,
    "intent": 0.18,
    "budget_fit": 0.12,
    "close_probability": 0.14,
    "responsiveness": 0.08,
    "repeat_potential": 0.1,
    "trust_signal": 0.07,
    "payment_readiness": 0.06,
    "route_friction": 0.07
  },
  "penalties": {
    "risk": 0.16,
    "identity_uncertainty": 0.08,
    "scope_uncertainty": 0.06,
    "human_dependency": 0.06,
    "policy_risk": 0.3
  },
  "guardrails": {
    "minimum_evidence_for_high_priority": 4,
    "never_score_sensitive_traits": true,
    "never_infer_purchasing_power_from_sensitive_or_protected_traits": true,
    "score_explains_why": true,
    "confidence_separate_from_score": true,
    "update_after_material_event": true,
    "score_is_priority_not_truth": true
  },
  "priority_bands": {
    "HOT": [
      80,
      100
    ],
    "HIGH": [
      65,
      79.99
    ],
    "MEDIUM": [
      45,
      64.99
    ],
    "LOW": [
      0,
      44.99
    ]
  },
  "recommended_actions": {
    "HOT": "prioritize_current_conversation_or_offer",
    "HIGH": "qualify_and_move_to_next_small_commitment",
    "MEDIUM": "nurture_or_probe_for_missing_fit",
    "LOW": "do_not_force; monitor_for_new_signal"
  }
}
